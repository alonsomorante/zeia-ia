# .env del bot en el servidor (/opt/zeia-bot/app/.env). Solo lo que el bot usa:
# NO van las claves de OpenRouter ni de ElevenLabs.
# La forma fácil: en la laptop, `python deploy/bot/empaquetar.py --env` arma
# este archivo con los valores reales de tu .env (dist/bot.env).

# --- Base de energía (producción, por túnel SSH) ---
ENERGIA_DB_HOST=127.0.0.1
ENERGIA_DB_PORT=55432
ENERGIA_DB_USER=postgres
ENERGIA_DB_PASSWORD=
ENERGIA_DB_NAME=energy
USE_SSH_TUNNEL_ENERGIA=true
SSH_KEY_ENERGIA=energy.pem
SSH_USER_ENERGIA=ubuntu
SSH_HOST_ENERGIA=54.242.41.196
SSH_REMOTE_HOST_ENERGIA=172.31.29.136
SSH_REMOTE_PORT_ENERGIA=5432

# --- Base ambiental (producción, por túnel SSH) ---
AMBIENTAL_DB_HOST=127.0.0.1
AMBIENTAL_DB_PORT=5435
AMBIENTAL_DB_USER=postgres
AMBIENTAL_DB_PASSWORD=
AMBIENTAL_DB_NAME=valhalladb
USE_SSH_TUNNEL_AMBIENTAL=true
SSH_KEY_AMBIENTAL=valhallaprod.pem
SSH_USER_AMBIENTAL=ubuntu
SSH_HOST_AMBIENTAL=ec2-44-206-41-101.compute-1.amazonaws.com
SSH_REMOTE_HOST_AMBIENTAL=172.31.29.136
SSH_REMOTE_PORT_AMBIENTAL=5432

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Avisos automáticos y foto de cierre ---
AVISOS_MODO=simular
AVISOS_HORARIO=08:00-20:00
AVISOS_RESUMEN=08:00
AVISOS_CICLO_MIN=5
FOTO_CIERRE=00:10
FOTOS_DIA=09:00,14:00,20:00
